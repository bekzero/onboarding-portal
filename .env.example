# Auth.js / KZero OIDC
AUTH_SECRET=replace-with-a-random-secret
AUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/onboarding_portal?schema=public
# Optional: use a separate direct/admin connection only for Prisma CLI commands.
DIRECT_URL=postgresql://user:password@localhost:5432/onboarding_portal?schema=public
# Optional: keep the Prisma Postgres adapter pool tiny in serverless environments.
PRISMA_SERVERLESS_POOL_MAX=1
OIDC_SECRET_ENCRYPTION_KEY=replace-with-a-32-byte-base64-hex-or-raw-key
AUTH_KEYCLOAK_ID=your-kzero-oidc-client-id
AUTH_KEYCLOAK_SECRET=your-kzero-oidc-client-secret
# Issuer pattern: https://ca.auth.kzero.com/realms/<ExactTenantName>
# Tenant / realm names are case-sensitive and must match KZero exactly.
AUTH_KEYCLOAK_ISSUER=https://ca.auth.kzero.com/realms/ABCMSP

# Dedicated KZero employee identity provider for attributable administration.
# Keep blank until the issuer/client and application-role mappings are approved.
# This must not point at an MSP or customer tenant realm.
STAFF_AUTH_ISSUER=
STAFF_AUTH_CLIENT_ID=
STAFF_AUTH_CLIENT_SECRET=
STAFF_AUTH_ADMIN_ROLE=
STAFF_AUTH_SALES_ENGINEER_ROLE=
STAFF_AUTH_VIEWER_ROLE=
# Optional defense-in-depth allowlist of immutable OIDC subject identifiers.
STAFF_AUTH_ALLOWED_SUBJECTS=

# KZero tenant discovery helpers
KZERO_OIDC_BASE_URL=https://ca.auth.kzero.com
KZERO_OIDC_REDIRECT_URI=https://onboarding-portal20.vercel.app/api/oidc/callback
KZERO_OIDC_CLIENT_ID_ABCMSP=portal-abcmsp
KZERO_OIDC_CLIENT_SECRET_ABCMSP=replace-me
KZERO_TEST_TENANT=abcmsp

# Temporary admin access
ADMIN_ACCESS_CODE=change-me
ADMIN_SESSION_COOKIE=kzero_admin_session
# Optional audit label until named admin identities are available.
ADMIN_AUDIT_ACTOR=admin-session

# Blob storage for onboarding documents
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token

# Zoho Marketing Automation remains disabled until a later approved phase.
ZOHO_DISPATCH_ENABLED=false
ZOHO_EVENT_EMISSION_ENABLED=false
ZMA_NUDGE_EVALUATION_ENABLED=false
ZMA_NUDGE_EVALUATION_BATCH_SIZE=50
# Phase 4 external writes have independent gates. The kill switch defaults to on
# even when this variable is absent.
ZOHO_GLOBAL_KILL_SWITCH=true
ZOHO_CONTACT_SYNC_ENABLED=false
ZOHO_JOURNEY_TRIGGERING_ENABLED=false
ZOHO_AUTOMATIC_DISPATCH_ENABLED=false
ZOHO_PRODUCTION_DISPATCH_APPROVED=false
ZOHO_DISPATCH_MODE=disabled
ZOHO_DISPATCH_BATCH_SIZE=10
ZOHO_DISPATCH_LEASE_SECONDS=120
CRON_SECRET=
# Server-only US data-center OAuth credentials. Never expose these to client code.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Canonical production portal base used in authenticated plan links.
PORTAL_PUBLIC_BASE_URL=
# KZero Partner Onboarding list and topic identifiers.
ZMA_LIST_KEY=
ZMA_TOPIC_ID=
# Set true only after the controlled Zoho tests documented in the Phase 2 runbook.
ZMA_PRIVATE_LIST_VERIFIED=false
ZMA_FIELD_MAPPING_VERIFIED=false
ZMA_J1_JOURNEY_KEY=
ZMA_J1_TRIGGER_KEY=
ZMA_J3_JOURNEY_KEY=
ZMA_J3_TRIGGER_KEY=
ZMA_J5_JOURNEY_KEY=
ZMA_J5_TRIGGER_KEY=
ZMA_J8_JOURNEY_KEY=
ZMA_J8_TRIGGER_KEY=
# Test mode uses separate journeys; production keys are rejected in test mode.
ZMA_TEST_J1_JOURNEY_KEY=
ZMA_TEST_J1_TRIGGER_KEY=
ZMA_TEST_J3_JOURNEY_KEY=
ZMA_TEST_J3_TRIGGER_KEY=
ZMA_TEST_J5_JOURNEY_KEY=
ZMA_TEST_J5_TRIGGER_KEY=
ZMA_TEST_J8_JOURNEY_KEY=
ZMA_TEST_J8_TRIGGER_KEY=
# Controlled test operations require explicit flags and both allowlists. Keep disabled by default.
ZOHO_TEST_SYNC_ENABLED=false
ZOHO_TEST_FIXTURE_ENABLED=false
ZOHO_TEST_DATABASE_CONFIRMED=false
ZMA_J8_NFR_RULE_APPROVED=false
ZOHO_TEST_EMAIL_ALLOWLIST=
ZOHO_TEST_PLAN_IDS=
# Phase 7A isolated database rehearsal. Never point these at production.
ZOHO_PHASE7A_DATABASE_RESOURCE_NAME=
ZOHO_PHASE7A_DATABASE_URL=
ZOHO_PHASE7A_DIRECT_URL=
ZOHO_PHASE7A_ISOLATED_CONFIRMATION=
ZOHO_PHASE7A_EMPTY_INITIALIZATION_CONFIRMATION=
ZOHO_PHASE7A_BACKUP_RESTORE_REFERENCE=
ZOHO_PHASE7A_BACKUP_RESTORE_CONFIRMED=
# Phase 7B.1 read-only live verification. Keep the authorization blank until an
# approved test window and keep credentials in an ignored local file.
ZOHO_PHASE7B1_EXPECTED_ORGANIZATION=org859403413
ZOHO_PHASE7B1_ORGANIZATION_VERIFICATION_REFERENCE=
ZOHO_PHASE7B1_OAUTH_SCOPES=ZohoMarketingAutomation.lead.READ,ZohoMarketingAutomation.lead.CREATE-UPDATE,ZohoMarketingAutomation.journey.READ
ZOHO_PHASE7B1_READ_ONLY_AUTHORIZATION=
ZOHO_PHASE7B1_APPROVED_INTERNAL_EMAILS=
ZOHO_PHASE7B1_EXPECTED_LIST_OWNER=
